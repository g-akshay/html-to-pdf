{
  "name": "htmlconvert",
  "version": "0.1.0",
  "description": "Convert HTML files and folders to PDF and EPUB — CLI and web UI with full support for canvas, SVG, charts, and custom fonts",
  "type": "module",
  "bin": {
    "html-convert": "./bin/html-convert.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node bin/html-convert.js",
    "serve": "node bin/html-convert.js serve"
  },
  "keywords": [
    "html",
    "pdf",
    "epub",
    "html-to-pdf",
    "html-to-epub",
    "converter",
    "puppeteer",
    "cli",
    "canvas",
    "svg",
    "charts"
  ],
  "homepage": "https://github.com/g-akshay/html-to-pdf#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/g-akshay/html-to-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/g-akshay/html-to-pdf/issues"
  },
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "cheerio": "^1.0.0",
    "commander": "^14.0.0",
    "epub-gen-memory": "^1.1.2",
    "express": "^4.21.2",
    "figlet": "^1.8.0",
    "gradient-string": "^3.0.0",
    "inquirer": "^12.6.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.2",
    "open": "^10.1.0",
    "ora": "^8.2.0",
    "puppeteer": "^22.15.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0"
  }
}
